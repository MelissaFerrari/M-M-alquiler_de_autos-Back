	@PatchMapping("/autos/{dominio}")
	public ResponseEntity<?> modificarCampoAuto(
	        @PathVariable String dominio,
	        @RequestBody Map<String, Object> cambios) {

	    Auto auto = autoService.buscarAutoPorDominio(dominio);

	    if (auto == null) {
	        return ResponseEntity.notFound().build();
	    }

	    cambios.forEach((campo, valor) -> {
	        switch (campo) {
	            case "marca":
	                auto.setMarca((String) valor);
	                break;
	            case "modelo":
	                auto.setModelo((String) valor);
	                break;
	            case "kilometros":
	                auto.setKilometros((String) valor);
	                break;
	            case "alquilado":
	                if (valor instanceof Boolean) {
	                    auto.setAlquilado((Boolean) valor);
	                } else if (valor instanceof Number) {
	                    auto.setAlquilado(((Number) valor).intValue() == 1);
	                }
	                break;
	            case "dominio":
	                // No se permite modificar el dominio
	                break;
	        }
	    });

	    autoService.actualizarAuto(auto);
	    return ResponseEntity.ok(Map.of("mensaje", "Auto modificado correctamente"));
	}


	
}
